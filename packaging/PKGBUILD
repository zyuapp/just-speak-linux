# Local source snapshot recipe; this package is not published in the AUR.
# See packaging/README.md for the matching git archive command.
pkgname=just-speak-linux
pkgver=0.2.2
pkgrel=1
pkgdesc='Offline voice dictation with GTK4 settings and optional Omarchy integration'
arch=('x86_64')
# Principal licenses; complete native/Rust texts and inventories ship below
# /usr/share/licenses/just-speak-linux. TTS/eSpeak/Piper are excluded.
license=('MIT' 'Apache-2.0' 'BSD-2-Clause' 'BSD-3-Clause' 'MPL-2.0' 'Zlib' 'Unicode-3.0')
depends=('gcc-libs' 'glibc' 'pipewire' 'wireplumber' 'wl-clipboard'
         'gjs' 'gtk4' 'systemd' 'bash' 'curl' 'python' 'util-linux' 'coreutils')
optdepends=('hyprland: supported focus-safe automatic paste and shortcut editing'
            'quickshell: recording overlay and optional Omarchy bar widget')
makedepends=('cargo' 'cmake' 'make')
checkdepends=('lua')
source=("$pkgname-$pkgver.tar.gz")
# Generated by the local builder, not a remotely published source artifact.
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo fetch --locked
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    # CMake fetches hash-pinned native sources/ORT on first build. Cargo's
    # --frozen governs Rust dependencies, not these native downloads.
    scripts/build-runtime.sh "$srcdir/just-speak-native"
    export SHERPA_ONNX_LIB_DIR="$srcdir/just-speak-native/lib"
    cargo build --release --frozen
    rm -rf "$srcdir/just-speak-licenses"
    python3 scripts/collect-licenses.py "$srcdir/just-speak-licenses"
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    export SHERPA_ONNX_LIB_DIR="$srcdir/just-speak-native/lib"
    cargo test --frozen
    nm -C --defined-only target/release/just-speak | python3 -c '
import re, sys
symbols = sys.stdin.read()
if not symbols.strip() or re.search(r"espeak[_:]|piper::|piper_phonemize", symbols, re.I):
    raise SystemExit("Cannot verify an ASR-only executable: missing symbols or TTS code found")
'
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 target/release/just-speak "$pkgdir/usr/bin/just-speak"
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a "$srcdir/just-speak-licenses/." "$pkgdir/usr/share/licenses/$pkgname/"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -m644 docs/desktop-support.md docs/updates.md "$pkgdir/usr/share/doc/$pkgname/"
    install -d "$pkgdir/usr/share/just-speak/"{ui,gtk,packaging}
    install -m644 ui/*.qml ui/manifest.json "$pkgdir/usr/share/just-speak/ui/"
    install -m644 gtk/*.js "$pkgdir/usr/share/just-speak/gtk/"
    install -m644 packaging/README.md packaging/hyprland.lua "$pkgdir/usr/share/just-speak/packaging/"
    install -Dm755 scripts/download-model.sh "$pkgdir/usr/share/just-speak/scripts/download-model.sh"
    install -Dm644 packaging/just-speak.desktop "$pkgdir/usr/share/applications/just-speak.desktop"
    install -Dm644 packaging/just-speak.service "$pkgdir/usr/lib/systemd/user/just-speak.service"
    install -Dm644 packaging/just-speak-overlay.service "$pkgdir/usr/lib/systemd/user/just-speak-overlay.service"
}
