# Build a local snapshot; see packaging/README.md for the git archive command.
pkgname=just-speak-linux
pkgver=0.1.0
pkgrel=1
pkgdesc='Local push-to-talk dictation for Omarchy and Hyprland'
arch=('x86_64')
# Original source is MIT. The default native runtime also includes Apache-2.0
# sherpa-onnx and GPL-3.0-or-later eSpeak NG; see THIRD_PARTY_NOTICES.md.
license=('MIT' 'Apache-2.0' 'GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'pipewire-audio' 'wl-clipboard' 'hyprland'
         'bash' 'curl' 'python' 'util-linux' 'coreutils')
optdepends=('quickshell: recording overlay and Omarchy bar widget')
makedepends=('cargo')
checkdepends=('lua')
source=("$pkgname-$pkgver.tar.gz")
# This is a locally generated development snapshot, not a published release.
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo fetch --locked
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    # sherpa-onnx's build script downloads its native static runtime on first
    # build; Cargo's --frozen applies to crates, not that upstream download.
    cargo build --release --frozen
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo test --frozen
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 target/release/just-speak "$pkgdir/usr/bin/just-speak"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -d "$pkgdir/usr/share/just-speak/ui" "$pkgdir/usr/share/just-speak/packaging"
    install -m644 ui/*.qml ui/manifest.json "$pkgdir/usr/share/just-speak/ui/"
    install -m644 packaging/README.md packaging/hyprland.lua "$pkgdir/usr/share/just-speak/packaging/"
    install -Dm644 packaging/just-speak.service "$pkgdir/usr/lib/systemd/user/just-speak.service"
    install -Dm644 packaging/just-speak-overlay.service "$pkgdir/usr/lib/systemd/user/just-speak-overlay.service"
}
